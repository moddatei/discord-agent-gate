# Discord Bot Credentials
# Get your token at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# Channel ID where confirmation prompts will be sent
# Right click channel in Discord -> Copy Channel ID (Enable Developer Mode in Discord Settings > Advanced)
DISCORD_CHANNEL_ID=123456789012345678

# Local IPC port for agent communication
LOCAL_PORT=9876

# Timeout in seconds before auto-denying a request (default: 300 = 5 minutes)
TIMEOUT_SECONDS=300

# Optional: Ping a user ID or role on approval request (e.g. <@123456789>)
DISCORD_MENTION_ROLE_OR_USER=
